s.boot;


s.waitForBoot({

    // Мягкий шумовой фон
    SynthDef(\cafeAir, {
        var noise = PinkNoise.ar(0.05);
        var filt = RLPF.ar(noise, LFNoise1.kr(0.2).range(500, 2000), 0.3);
        var verb = FreeVerb.ar(filt, mix: 0.3, room: 0.8, damp: 0.4);
        Out.ar(0, verb!2);
    }).add;

    // Медленные гармоники 
    SynthDef(\warmChords, {
        var freqs = [220, 330, 440] * LFNoise1.kr(0.05).range(0.98, 1.02);
        var sig = Mix.fill(3, { |i|
            SinOsc.ar(freqs[i], 0, 0.07)
        });
        sig = sig * EnvGen.kr(Env.asr(4, 1, 4), doneAction: 2);
        sig = LPF.ar(sig, 1200);
        sig = FreeVerb.ar(sig, mix: 0.4, room: 0.9);
        Out.ar(0, sig!2);
    }).add;

    // Лёгкие щелчки 
    SynthDef(\tinyClicks, {
        var trig = Dust.kr(3); // редкие щелчки
        var click = Decay2.kr(trig, 0.001, 0.05) * WhiteNoise.ar(0.02);
        click = HPF.ar(click, 2000);
        Out.ar(0, click!2);
    }).add;

    // Запуск
    s.sync;
    x = Synth(\cafeAir);
    y = Synth(\warmChords);
    z = Synth(\tinyClicks);

});

s.freeAll;
