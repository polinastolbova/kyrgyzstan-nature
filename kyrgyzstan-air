s.boot;


s.waitForBoot({

    // Сухой степной ветер
    SynthDef(\steppeWind, {
        var noise = BrownNoise.ar(0.08);
        var filt = BPF.ar(noise, LFNoise1.kr(0.1).range(200, 900), 0.4);
        var mod = LFNoise2.kr(0.05).range(0.3, 1.2);
        var wind = filt * mod;
        wind = FreeVerb.ar(wind, mix: 0.25, room: 0.8, damp: 0.2);
        Out.ar(0, wind!2);
    }).add;

    // Дальние горы — медленный низкочастотный дрейф
    SynthDef(\mountainDrone, {
        var base = LFNoise1.kr(0.02).range(40, 70);
        var sig = SinOsc.ar(base, 0, 0.15)
                + SinOsc.ar(base * 0.5, 0, 0.1)
                + SinOsc.ar(base * 1.5, 0, 0.05);
        sig = LPF.ar(sig, 300);
        sig = FreeVerb.ar(sig, mix: 0.35, room: 0.95);
        Out.ar(0, sig!2);
    }).add;

    // Запуск
    s.sync;
    x = Synth(\steppeWind);
    y = Synth(\mountainDrone);

});


s.freeAll;
