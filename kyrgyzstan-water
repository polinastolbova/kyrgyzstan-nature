s.boot;

s.waitForBoot({

    // Сухой степной ветер
    SynthDef(\steppeWind, {
        var noise = BrownNoise.ar(0.08);
        var filt = BPF.ar(noise, LFNoise1.kr(0.1).range(200, 900), 0.4);
        var mod = LFNoise2.kr(0.05).range(0.3, 1.2);
        var wind = filt * mod;
        wind = FreeVerb.ar(wind, mix: 0.2, room: 0.7, damp: 0.2);
        Out.ar(0, wind!2);
    }).add;

    // медленные низкие синусоиды
    SynthDef(\mountainDrone, {
        var base = LFNoise1.kr(0.02).range(40, 70); // низкие частоты
        var sig = SinOsc.ar(base, 0, 0.15)
                + SinOsc.ar(base * 0.5, 0, 0.1)
                + SinOsc.ar(base * 1.5, 0, 0.05);
        sig = LPF.ar(sig, 300);
        sig = FreeVerb.ar(sig, mix: 0.3, room: 0.9);
        Out.ar(0, sig!2);
    }).add;

    // редкие трески
    SynthDef(\fireCrackle, {
        var trig = Dust.kr(8); // частота тресков
        var env = Decay2.kr(trig, 0.001, 0.05);
        var crack = env * WhiteNoise.ar(0.1);
        crack = BPF.ar(crack, LFNoise1.kr(2).range(2000, 6000), 0.7);
        Out.ar(0, crack!2);
    }).add;

    // Запуск
    s.sync;
    x = Synth(\steppeWind);
    y = Synth(\mountainDrone);
    z = Synth(\fireCrackle);

});

s.freeAll;
